<div class="flex flex-col justify-center border-2 w-10vw rounded-md p-4 m-2 gap-2"><img src="@Imagen" class="w-full h-1/2 object-cover rounded-md" /><h2 class="text-bold text-2xl">@NombreCafe</h2><p><b>Descripción: </b>@DescripcionCafe</p><p class="font-bold text-white bg-green-600 rounded-xl p-3">@PrecioCafe Bs.</p></div>

@code {

    [Parameter] public string? Imagen { get; set; }

    [Parameter] public string? NombreCafe { get; set; }

    [Parameter] public string? DescripcionCafe { get; set; }

    [Parameter] public decimal PrecioCafe { get; set; }

}