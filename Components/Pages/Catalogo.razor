@page "/catalogo"

<div class="min-h-screen bg-[#FFF3F5] p-5 md:p-10">

    <!-- ENCABEZADO -->
    <div class="relative overflow-hidden bg-[#D991A5] rounded-[30px] p-8 md:p-12 mb-10 text-center shadow-lg">

        <div class="absolute -top-10 -left-10 w-36 h-36 bg-[#EAB6C4] rounded-full opacity-50"></div>
        <div class="absolute -bottom-12 -right-8 w-44 h-44 bg-[#F1C6D0] rounded-full opacity-50"></div>

        <div class="relative z-10">
            <p class="text-[#FFF0F3] tracking-[0.3em] text-xs md:text-sm font-semibold mb-4">
                ♡ CAFÉ · AMOR · MOMENTOS ♡
            </p>

            <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">
                Nuestra Cartita
            </h1>

            <p class="text-[#FFF4F6] text-base md:text-lg">
                Un rinconcito dulce para disfrutar tu café favorito.
            </p>

            <div class="flex justify-center items-center gap-3 mt-6">
                <span class="text-white text-xl">♡</span>
                <div class="w-16 h-1 bg-[#FFF0F3] rounded-full"></div>
                <span class="text-white text-xl">♡</span>
            </div>
        </div>
    </div>

    <!-- MENSAJE -->
    <div class="text-center mb-9">
        <h2 class="text-2xl md:text-3xl font-bold text-[#A85F76]">
            Nuestros cafecitos ☕
        </h2>

        <p class="text-[#B98796] mt-2">
            Preparados con mucho cariño para ti ♡
        </p>
    </div>

    <!-- CATÁLOGO -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-7">

        @foreach (Cafe cafe in lstCafes)
        {
            <div class="group flex flex-col bg-white rounded-[25px] overflow-hidden border-2 border-[#F5DCE3] shadow-md hover:shadow-xl hover:-translate-y-2 transition-all duration-300">

                <div class="overflow-hidden h-52 relative">
                    <img src="@cafe.Imagen"
                         alt="@cafe.NombreCafe"
                         class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />

                    <div class="absolute top-3 right-3 bg-white/90 rounded-full px-3 py-1 text-[#C87991] text-sm shadow-sm">
                        ♡ Especial
                    </div>
                </div>

                <div class="flex flex-col flex-grow p-5 gap-3">

                    <h2 class="text-xl font-bold text-[#A85F76]">
                        @cafe.NombreCafe
                    </h2>

                    <div class="w-12 h-1 bg-[#E8A9BA] rounded-full"></div>

                    <p class="text-[#997783] text-sm leading-relaxed flex-grow">
                        <b class="text-[#A85F76]">Descripción:</b>
                        @cafe.DescripcionCafe
                    </p>

                    <div class="mt-2 bg-[#FCE8ED] border border-[#F3D0DA] text-[#B45F79] rounded-2xl p-3 text-center font-bold text-lg group-hover:bg-[#F6D6E0] transition-colors">
                        ♡ @cafe.PrecioCafe Bs. ♡
                    </div>

                </div>
            </div>
        }

    </div>

    <!-- PIE DE PÁGINA -->
    <div class="text-center mt-14 pb-6">

        <div class="flex justify-center items-center gap-3 mb-4">
            <div class="w-12 h-px bg-[#E4A6B7]"></div>
            <span class="text-[#D991A5] text-xl">♡</span>
            <div class="w-12 h-px bg-[#E4A6B7]"></div>
        </div>

        <p class="text-[#A85F76] font-bold tracking-widest text-sm">
            HECHO CON AMOR Y CAFÉ
        </p>

        <p class="text-[#C18D9C] text-xs mt-3">
            Gracias por formar parte de nuestros momentos dulces ♡
        </p>

    </div>

</div>

